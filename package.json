{
  "name": "it-services-management",
  "version": "1.0.0",
  "description": "Professional IT Services Management Platform",
  "scripts": {
    "dev:frontend": "cd frontend && npm install && npm start",
    "dev:backend": "cd backend && npm install && npm start",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm install",
    "build:backend": "cd backend && npm install"
  },
  "keywords": ["it-services", "management", "docker", "gitlab-ci"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
